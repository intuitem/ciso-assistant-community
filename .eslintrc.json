{
    "overrides": [
      {
        "files": ["*.svelte", "*.svelte.js", "*.svelte.ts"],
        "globals": {
          "$state": "readonly",
          "$derived": "readonly",
          "$effect": "readonly",
          "$props": "readonly",
          "$bindable": "readonly",
          "$inspect": "readonly",
          "$host": "readonly"
        }
      }
    ],
    "rules": {
      "@typescript-eslint/no-unused-vars": [
        "error",
        {
          "args": "all",
          "argsIgnorePattern": "^_",
          "caughtErrors": "all",
          "caughtErrorsIgnorePattern": "^_",
          "destructuredArrayIgnorePattern": "^_",
          "varsIgnorePattern": "^_",
          "ignoreRestSiblings": true
        }
      ]
    }
  }
