# CISO Assistant Frontend Configuration
# This file is installed to /etc/ciso-assistant/frontend.env

# Backend API connection
PUBLIC_BACKEND_API_URL=http://localhost:8000/api

# Frontend server settings
PORT=3000
HOST=0.0.0.0

# Origin is read from your reverse proxy: the frontend cannot be used over plain http on :3000
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host

# Node environment
NODE_ENV=production
