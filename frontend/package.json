{
	"name": "frontend",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"prepare": "svelte-kit sync",
		"dev": "vite dev",
		"build": "paraglide-js compile --project ./project.inlang --output-structure locale-modules && vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"docs:shots": "./tests/docs-screenshots/run.sh",
		"test": "vitest",
		"test:ci": "vitest run",
		"test:ui": "vitest --ui",
		"test:a11y": "playwright test --config=playwright.a11y.config.ts",
		"test:a11y:dark": "A11Y_THEME=dark playwright test --config=playwright.a11y.config.ts",
		"a11y:page": "node scripts/build-a11y-page.mjs",
		"readme:list": "node scripts/generate-readme-list.mjs",
		"readme:image": "node scripts/render-readme-features.mjs",
		"readme:features": "node scripts/generate-readme-list.mjs && node scripts/render-readme-features.mjs",
		"test:e2e": "ARGS=\"$npm_config_args\" docker compose -f ./tests/docker-compose.e2e-tests.yml up --force-recreate --build -V",
		"coverage": "vitest run --coverage",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"postinstall": "paraglide-js compile --project ./project.inlang --output-structure locale-modules"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.29.3",
		"@playwright/test": "^1.64.1",
		"@skeletonlabs/skeleton": "^5.0.1",
		"@skeletonlabs/skeleton-svelte": "^5.0.1",
		"@svelte-put/copy": "^3.0.2",
		"@svelte-put/qr": "^1.2.1",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/d3-hierarchy": "^3.1.7",
		"@types/d3-selection": "^3.0.12",
		"@types/d3-zoom": "^3.0.9",
		"@types/node": "^24.19.2",
		"@typescript-eslint/eslint-plugin": "^8.72.1",
		"@typescript-eslint/parser": "^8.72.1",
		"@vincjo/datatables": "^1.14.10",
		"@vitest/coverage-v8": "^4.1.12",
		"@vitest/ui": "^4.1.12",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-intuitem-sveltekit": "file:plugins/eslint/eslint-plugin-intuitem-sveltekit",
		"eslint-plugin-svelte": "^3.23.1",
		"fast-check": "^4.10.2",
		"globals": "^15.15.0",
		"jsdom": "^26.1.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^3.5.2",
		"sv-typewriter": "^4.1.2",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"svelte-eslint-parser": "^1.10.0",
		"sveltekit-flash-message": "^3.0.0",
		"sveltekit-rate-limiter": "^0.8.0",
		"sveltekit-superforms": "^3.1.0",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"vitest": "^4.1.12",
		"zod": "^4.6.7"
	},
	"type": "module",
	"dependencies": {
		"@dagrejs/dagre": "^3.1.3",
		"@floating-ui/dom": "^1.8.0",
		"@fortawesome/fontawesome-free": "^7.3.1",
		"@simplewebauthn/browser": "^13.3.0",
		"@svar-ui/svelte-grid": "^2.7.5",
		"@unovis/svelte": "1.6.7",
		"@unovis/ts": "1.6.7",
		"@xyflow/svelte": "^1.7.0",
		"bits-ui": "^2.20.2",
		"d3-hierarchy": "^3.1.2",
		"d3-selection": "^3.0.0",
		"d3-zoom": "^3.0.0",
		"docx-preview": "^0.4.1",
		"dotenv": "^16.6.1",
		"driver.js": "^1.10.2",
		"echarts": "^6.1.0",
		"exceljs": "^4.4.0",
		"marked": "^16.4.2",
		"mermaid": "^12.2.0",
		"sanitize-html": "^2.18.1",
		"ssf": "^0.11.2",
		"svelte-multiselect": "^11.8.0",
		"svelte-persisted-store": "^0.12.0"
	},
	"packageManager": "pnpm@12.15.0",
	"imports": {
		"#lib/*.js": "./src/lib/*.ts",
		"#lib/*": "./src/lib/*",
		"#paraglide/*": "./src/paraglide/*"
	}
}
