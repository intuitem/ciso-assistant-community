{
	"name": "frontend",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"prepare": "svelte-kit sync",
		"dev": "vite dev",
		"build": "paraglide-js compile --project ./project.inlang --output-structure locale-modules && vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"test:ci": "vitest run",
		"test:ui": "vitest --ui",
		"test:a11y": "playwright test --config=playwright.a11y.config.ts",
		"test:a11y:dark": "A11Y_THEME=dark playwright test --config=playwright.a11y.config.ts",
		"a11y:page": "node scripts/build-a11y-page.mjs",
		"readme:list": "node scripts/generate-readme-list.mjs",
		"readme:image": "node scripts/render-readme-features.mjs",
		"readme:features": "node scripts/generate-readme-list.mjs && node scripts/render-readme-features.mjs",
		"test:e2e": "ARGS=\"$npm_config_args\" docker compose -f ./tests/docker-compose.e2e-tests.yml up --force-recreate --build -V",
		"coverage": "vitest run --coverage",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"postinstall": "paraglide-js compile --project ./project.inlang --output-structure locale-modules"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.24.1",
		"@playwright/test": "^1.62.1",
		"@skeletonlabs/skeleton": "^4.15.2",
		"@skeletonlabs/skeleton-svelte": "^4.15.2",
		"@svelte-put/copy": "^3.0.2",
		"@svelte-put/qr": "^1.2.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.10.0",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^24.13.3",
		"@typescript-eslint/eslint-plugin": "^8.68.0",
		"@typescript-eslint/parser": "^8.68.0",
		"@vincjo/datatables": "^1.14.10",
		"@vitest/coverage-v8": "^4.1.11",
		"@vitest/ui": "^4.1.11",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-intuitem-sveltekit": "file:plugins/eslint/eslint-plugin-intuitem-sveltekit",
		"eslint-plugin-svelte": "^3.23.0",
		"fast-check": "^4.9.0",
		"globals": "^15.15.0",
		"jsdom": "^26.1.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^3.5.2",
		"sv-typewriter": "^4.1.2",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"svelte-eslint-parser": "^1.8.1",
		"sveltekit-flash-message": "^2.4.6",
		"sveltekit-rate-limiter": "^0.5.2",
		"sveltekit-superforms": "^2.30.2",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"vite": "^8.2.2",
		"vitest": "^4.1.11",
		"zod": "^4.4.3"
	},
	"type": "module",
	"dependencies": {
		"@dagrejs/dagre": "^3.1.1",
		"@floating-ui/dom": "^1.8.0",
		"@fortawesome/fontawesome-free": "^6.7.2",
		"@simplewebauthn/browser": "^13.3.0",
		"@unovis/svelte": "1.6.7",
		"@unovis/ts": "1.6.7",
		"@xyflow/svelte": "^1.6.3",
		"bits-ui": "^2.19.0",
		"docx-preview": "^0.4.0",
		"dotenv": "^16.6.1",
		"driver.js": "^1.8.0",
		"echarts": "^6.1.0",
		"exceljs": "^4.4.0",
		"marked": "^16.4.2",
		"sanitize-html": "^2.17.7",
		"ssf": "^0.11.2",
		"svelte-multiselect": "^11.8.0",
		"svelte-persisted-store": "^0.12.0",
		"wx-svelte-grid": "^2.7.0"
	},
	"packageManager": "pnpm@11.24.0"
}
