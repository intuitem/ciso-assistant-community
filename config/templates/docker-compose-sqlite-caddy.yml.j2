services:
  backend:
    {% if memcached.enabled %}
    depends_on:
      memcached:
        condition: service_started
    {% endif %}
    container_name: backend
    image: ghcr.io/intuitem/ciso-assistant-community/backend:latest
    pull_policy: always
    restart: always
    environment:
      {% if memcached.enabled %}
      - ENABLE_MEMCACHED=True
      {% endif %}
      - ALLOWED_HOSTS=backend,localhost{% if fqdn != 'localhost'%},{{ fqdn }}{% endif %}
      - CISO_ASSISTANT_URL=https://{{ fqdn }}:{{ port }}
      {% if mcp.enabled %}- OAUTH_DCR_ENABLED=True{% endif %}
      - DJANGO_DEBUG={{ enable_debug }}
      - AUTH_TOKEN_TTL=7200
      - HOME=/tmp
      - XDG_CACHE_HOME=/tmp/.cache
      - XDG_CONFIG_HOME=/tmp/.config
      - XDG_DATA_HOME=/tmp/.local/share
      {% if need_mailer %}
      - EMAIL_HOST={{ email.host }}
      - EMAIL_PORT={{ email.port }}
      {% if email.use_tls %}- EMAIL_USE_TLS={{ email.use_tls }}{% endif %}
      - EMAIL_HOST_USER={{ email.user }}
      - EMAIL_HOST_PASSWORD={{ email.password }}
      - DEFAULT_FROM_EMAIL={{ email.from_email }}
      {% endif %}
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    tmpfs:
      - /tmp:rw,noexec,nosuid,nodev
    volumes:
      {% if memcached.enabled %}
      - memcached_socket:/run/memcached
      {% endif %}
      - ./db:/code/db
    user: "1001:1001"
    healthcheck:
      test: ["CMD", "python3", "-c", "import urllib.request; urllib.request.urlopen('http://backend:8000/api/health/', timeout=5)"]
      interval: 10s
      timeout: 10s
      retries: 30
      start_period: 150s

  huey:
    container_name: huey
    image: ghcr.io/intuitem/ciso-assistant-community/backend:latest
    pull_policy: always
    depends_on:
      {% if memcached.enabled %}
      memcached:
        condition: service_started
      {% endif %}
      backend:
        condition: service_healthy
    restart: always
    environment:
      {% if memcached.enabled %}
      - ENABLE_MEMCACHED=True
      {% endif %}
      - ALLOWED_HOSTS=backend,localhost
      - CISO_ASSISTANT_URL=https://{{ fqdn }}:{{ port }}
      - DJANGO_DEBUG=False
      - AUTH_TOKEN_TTL=7200
      - HOME=/tmp
      - XDG_CACHE_HOME=/tmp/.cache
      - XDG_CONFIG_HOME=/tmp/.config
      - XDG_DATA_HOME=/tmp/.local/share
      {% if need_mailer %}
      - EMAIL_HOST={{ email.host }}
      - EMAIL_PORT={{ email.port }}
      {% if email.use_tls %}- EMAIL_USE_TLS={{ email.use_tls }}{% endif %}
      - EMAIL_HOST_USER={{ email.user }}
      - EMAIL_HOST_PASSWORD={{ email.password }}
      - DEFAULT_FROM_EMAIL={{ email.from_email }}
      {% endif %}
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    tmpfs:
      - /tmp:rw,noexec,nosuid,nodev
    volumes:
      {% if memcached.enabled %}
      - memcached_socket:/run/memcached
      {% endif %}
      - ./db:/code/db
    user: "1001:1001"
    entrypoint:
      - /bin/sh
      - -c
      - |
        python manage.py run_huey -w 2 --scheduler-interval 60

  {% if memcached.enabled %}
  memcached:
    container_name: memcached
    image: memcached:1.6-alpine
    restart: unless-stopped
    # Unix socket only: no network listener, and no network at all.
    command: ["memcached", "-s", "/run/memcached/memcached.sock", "-a", "0700", "-m", "16"]
    network_mode: none
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    user: "1001:1001"
    volumes:
      - memcached_socket:/run/memcached
  {% endif %}

  frontend:
    container_name: frontend
    environment:
      - PUBLIC_BACKEND_API_URL=http://backend:8000/api
      - PUBLIC_BACKEND_API_EXPOSED_URL=https://{{ fqdn }}:{{ port }}/api
      - PROTOCOL_HEADER=x-forwarded-proto
      - HOST_HEADER=x-forwarded-host
      - ADDRESS_HEADER=x-forwarded-for
      - XFF_DEPTH=1
      - HOME=/tmp
      - XDG_CACHE_HOME=/tmp/.cache
      - XDG_CONFIG_HOME=/tmp/.config
      - XDG_DATA_HOME=/tmp/.local/share
    image: ghcr.io/intuitem/ciso-assistant-community/frontend:latest
    pull_policy: always
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    tmpfs:
      - /tmp:rw,noexec,nosuid,nodev
    depends_on:
      backend:
        condition: service_healthy
    restart: always
    user: "1001:1001"

  {% if mcp.enabled %}
  mcp:
    container_name: mcp
    image: ghcr.io/intuitem/ciso-assistant-community/mcp:latest
    restart: unless-stopped
    depends_on:
      backend:
        condition: service_healthy
    environment:
      - API_URL=http://backend:8000/api
      - CA_MCP_TRANSPORT=streamable-http
      - CA_MCP_HOST=0.0.0.0
      - CA_MCP_PORT=8001
      - CA_MCP_AUTH=oauth
      - CISO_ASSISTANT_URL=https://{{ fqdn }}:{{ port }}
      # matched against the Host header; both forms, since the port is dropped for 443
      - CA_MCP_ALLOWED_HOSTS={{ fqdn }},{{ fqdn }}:{{ port }}
      - CA_MCP_ALLOW_ENV_TOKEN=false
      - HOME=/tmp
      - XDG_CACHE_HOME=/tmp/.cache
      - XDG_CONFIG_HOME=/tmp/.config
      - XDG_DATA_HOME=/tmp/.local/share
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    tmpfs:
      - /tmp:rw,noexec,nosuid,nodev
    user: "1001:1001"
  {% endif %}

  caddy:
    container_name: caddy
    image: caddy:2.11.4
    environment:
      - CISO_ASSISTANT_URL=https://{{ fqdn }}:{{ port }}
    depends_on:
      backend:
        condition: service_healthy
    restart: unless-stopped
    ports:
      - {{ port }}:{{ port }}{% if can_do_tls and port != 443 %}
      - 443:443{% endif %}
    volumes:
      - ./caddy_data:/data{% if not can_do_tls and use_custom_cert %}
      - {{ cert_config.cert_path }}:/etc/caddy/cert.pem:ro
      - {{ cert_config.key_path }}:/etc/caddy/key.pem:ro{% endif %}
    command: |
      sh -c 'echo "$$CISO_ASSISTANT_URL {
        reverse_proxy /api/* backend:8000{% if mcp.enabled %}
        reverse_proxy /.well-known/oauth-authorization-server* backend:8000
        @mcp path /mcp* /.well-known/oauth-protected-resource*
        reverse_proxy @mcp mcp:8001 {
          header_up -Cookie
          header_down -Set-Cookie
          header_down -Service-Worker-Allowed
          header_down Content-Security-Policy sandbox
          header_down X-Content-Type-Options nosniff
        }{% endif %}
        reverse_proxy /* frontend:3000{% if not can_do_tls %}{% if use_custom_cert %}
        tls /etc/caddy/cert.pem /etc/caddy/key.pem{% else %}
        tls internal{% endif %}{% endif %}
      }" > Caddyfile && caddy run'

  {% if kafka_dispatcher.enabled %}
  dispatcher:
    container_name: dispatcher
    image: ghcr.io/intuitem/ciso-assistant-community/dispatcher:latest
    # build:
    #   context: ../dispatcher
    restart: always
    environment:
      - API_URL=http://backend:8000/api
      - BOOTSTRAP_SERVERS={{ kafka_dispatcher.broker_url }}
      - KAFKA_USE_AUTH={{ kafka_dispatcher.kafka_use_auth }}
      {% if kafka_dispatcher.kafka_use_auth %}
      - KAFKA_SASL_MECHANISM={{ kafka_dispatcher.kafka_sasl_mechanism }}
      - KAFKA_USERNAME={{ kafka_dispatcher.kafka_username }}
      - KAFKA_PASSWORD={{ kafka_dispatcher.kafka_password }}
      {% endif %}
      - OBSERVATION_TOPIC={{ kafka_dispatcher.observation_topic }}
      - ERRORS_TOPIC={{ kafka_dispatcher.errors_topic }}
      {% if kafka_dispatcher.authentication == 'credentials' %}
      - USER_EMAIL={{ kafka_dispatcher.credentials.user_email }}
      - USER_PASSWORD={{ kafka_dispatcher.credentials.user_password }}
      - AUTO_RENEW_SESSION={{ kafka_dispatcher.auto_renew_session }}
      {% elif kafka_dispatcher.authentication == 'token' %}
      - TOKEN={{ kafka_dispatcher.token }}
      {% endif %}
      {% if kafka_dispatcher.s3_url %}
      - S3_URL={{ kafka_dispatcher.s3_url }}
      - S3_ACCESS_KEY={{ kafka_dispatcher.s3_access_key }}
      - S3_SECRET_KEY={{ kafka_dispatcher.s3_secret_key }}
      {% endif %}
    depends_on:
      backend:
        condition: service_healthy
  {% endif %}

{% if memcached.enabled %}
volumes:
  memcached_socket:
    # RAM-backed, owned by the uid the backend, huey and memcached run as;
    # it only holds the socket.
    driver_opts:
      type: tmpfs
      device: tmpfs
      o: "uid=1001,gid=1001,mode=0700,size=64k"
{% endif %}
